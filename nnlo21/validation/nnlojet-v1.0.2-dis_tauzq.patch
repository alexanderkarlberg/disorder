# NNLOJET v1.0.2 (GPL-3.0-or-later): local observable dis_tauzq = 1 - 2 sum_{p_z>0} p_z/Q
# (Breit frame, current hemisphere, w.r.t. the boson axis; = nnlo21's tau_zQ),
# for the event-shape validation of nnlo21 (9 Oct 2026). Apply in the NNLOJET
# source tree with: patch -p1 < nnlojet-v1.0.2-dis_tauzq.patch
--- a/driver/core/EvalDIS.f90	2026-10-09 19:04:58.390385109 +0200
+++ b/driver/core/EvalDIS.f90	2026-10-09 19:04:58.405662971 +0200
@@ -534,6 +534,22 @@
     end if
   end function eval_dis_thrust
 
+  !> tau_zQ = 1 - 2 sum_{current hemisphere} p_z / Q (Breit frame, w.r.t. the
+  !> boson axis, normalised to Q: infrared safe without an energy cut).
+  !> Added locally (9 Oct 2026) for the cross-check with disorder's nnlo21.
+  real(kind=wp) function eval_dis_tauzq(npar)
+    integer, intent(in) :: npar
+    real(kind=wp) :: top
+    integer :: i
+
+    top = 0._wp
+    do i = 4, npar
+      ! Select only particles in the current hemisphere (pz > 0)
+      if (kin(npar)%p(3, i) > 0._wp) top = top + kin(npar)%p(3, i)
+    end do
+    eval_dis_tauzq = 1._wp - 2._wp*top/value_q_dis
+  end function eval_dis_tauzq
+
